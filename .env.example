GEMINI_API_KEY=
DATA_GOV_IN_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# Default is demo auth so hackathon/local previews do not require Google OAuth setup.
# Set VITE_AUTH_MODE=firebase when Firebase OAuth domains and credentials are ready.
VITE_AUTH_MODE=demo
DEMO_AUTH_TOKEN=agrocare-demo-token

# Local development only. Production Firebase mode requires Firebase Admin and verified ID tokens.
ALLOW_UNAUTHENTICATED_DEV_AUTH=true
